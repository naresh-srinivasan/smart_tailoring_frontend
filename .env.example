# Copy to .env.local for local overrides. On Vercel set these under Project > Settings > Environment Variables.
# Backend origin, no trailing slash and no /api. Leave unset locally to use http://localhost:5000.
VITE_API_URL=https://your-backend.vercel.app
# Live notifications over Socket.IO (needs a long-running server; not available on Vercel Functions).
VITE_ENABLE_SOCKETS=false
